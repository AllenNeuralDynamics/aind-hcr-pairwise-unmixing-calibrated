{
	"version": 1,
	"base_image": "codeocean/lightning-jupyterlab:latest",
	"post_install": true,
	"options": {
		"registry_host_arg": true,
		"git_ask_pass": false,
		"mount_secrets": false
	},
	"installers": {
		"pip": {
			"packages": [
				{
					"name": "numpy",
					"version": "1.26.4"
				},
				{
					"name": "scipy",
					"version": "1.13.1"
				},
				{
					"name": "pandas",
					"version": "2.2.2"
				},
				{
					"name": "pyarrow",
					"version": "16.1.0"
				},
				{
					"name": "scikit-learn",
					"version": "1.5.0"
				},
				{
					"name": "h5py",
					"version": "3.11.0"
				},
				{
					"name": "anndata",
					"version": "0.10.8"
				}
			],
			"options": {},
			"pre_install_options": {}
		}
	}
}
