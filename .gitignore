# Code Ocean specific files and directories. metadata/metadata.yml is generated by
# Code Ocean per capsule, so tracking it makes every capsule fight over it.
/data/
/results/
/scratch/
metadata/metadata.yml

# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Distribution / packaging
build/
dist/
*.egg-info/
*.egg

# Unit test / coverage
.pytest_cache/
.coverage
htmlcov/

# Environments
.env
.venv
env/
venv/

# MacOS
**/.DS_Store

# VS Code / code-server state written inside the capsule. MUST stay untracked.
#
# Tracking these broke fresh clones outright: git aborts the checkout when it cannot
# write them (the clone target already has code-server holding those paths open), and
# every file alphabetically after code/ is then never written -- environment/, src/,
# tests/, pyproject.toml. A newly cloned capsule came up with no environment/Dockerfile
# and looked like the file had been deleted from the repo.
#
# They are also IDE logs, caches and session keys, not source: they churn every session,
# and code/.vscode/serve-web-key-half is random key material for the code-server web
# endpoint.
.vscode/*
!.vscode/settings.json
.vscode
code/.vscode/
